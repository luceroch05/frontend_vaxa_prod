# ── Vaxa · .htaccess de PRODUCCION (SPA React Router) ─────────────────────────
# Va en el document root del subdominio (ej: sistemas.vaxasys.com), junto al index.html.
# NO viene en el dist/ (Vite lo omite con el plugin omitirHtaccess); se pone a mano.
#
# CAUSA DEL 403 EN VPS/Apache: el RewriteRule queda PROHIBIDO si el directorio no tiene
# "FollowSymLinks" -> Apache responde 403 Forbidden. Por eso la 1ra linea es clave.
#
# Si "Options +FollowSymLinks" da 500 -> cambiala por "Options +SymLinksIfOwnerMatch".
# Si igual da 500 -> hay que habilitarlo en el vhost de Apache (AllowOverride All +
# Options +FollowSymLinks en el <Directory> del sitio) y reiniciar Apache.
# ──────────────────────────────────────────────────────────────────────────────

Options +FollowSymLinks
DirectoryIndex index.html

RewriteEngine On
RewriteBase /

# Si NO es un archivo ni una carpeta real -> servir index.html (React Router).
# Esto evita el 403/404 al entrar directo por una URL profunda o al hacer F5.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]


